# Copy to .env.local and fill in. .env.local is git-ignored: never commit it.

# Public site URL (canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ──────────────────────────────────────────────────────────────
# Supabase → Project Settings → API Keys (and Data API for the URL).

# Safe in the browser. Data is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# SERVER ONLY. Bypasses Row Level Security. Used only by /api/requests to save
# validated public requests. Never prefix with NEXT_PUBLIC_, never share it.
SUPABASE_SECRET_KEY=sb_secret_...
